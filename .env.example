SOAST_DATABASE_URL=sqlite:///./soast.db
SOAST_ADMIN_USERNAME=admin
SOAST_ADMIN_PASSWORD=REEMPLAZAR_CON_UNA_CLAVE_SEGURA
SOAST_TIMEZONE=America/Guatemala
# Microsoft Entra ID, aplicación SOAST-Graph-Integration
# SOAST_GRAPH_TENANT_ID=
# SOAST_GRAPH_CLIENT_ID=
# SOAST_GRAPH_ORGANIZER=cuenta-dedicada@dominio.com
# Certificado público y clave privada correspondientes al registro en Entra ID.
# SOAST_GRAPH_CERT_PATH=/run/secrets/soast/graph.crt
# SOAST_GRAPH_KEY_PATH=/run/secrets/soast/graph.key
# Compatibilidad temporal con instalaciones existentes; preferir certificado.
# SOAST_GRAPH_CLIENT_SECRET=